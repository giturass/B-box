{
  "experimental": {
    "scripts": {
      "enabled": false,
      "http": [
        {
          "name": "Dynamic API mock",
          "pattern": "^https?://api\\.example\\.test/dynamic$",
          "phase": "request",
          "source": "$done({response:{status:200,headers:{'Content-Type':'application/json'},body:JSON.stringify({ok:true,method:$request.method})}});"
        },
        {
          "name": "Request JSON",
          "pattern": "^https?://api\\.example\\.test/json$",
          "phase": "request",
          "requires_body": true,
          "source": "const body=JSON.parse($request.body); body.debug=true; $done({body:JSON.stringify(body)});"
        },
        {
          "name": "Response JSON",
          "pattern": "^https?://api\\.example\\.test/json$",
          "phase": "response",
          "requires_body": true,
          "full_headers": true,
          "timeout_ms": 200,
          "resource": "response.js"
        }
      ],
      "cron": [
        {
          "name": "Daily HTTP task",
          "cron": "0 2 * * *",
          "timezone": "Asia/Shanghai",
          "timeout_ms": 5000,
          "argument": "https://api.example.test/task",
          "source": "$httpClient.get($argument, function(error, response, data) { if (error) throw Error(error); console.log(response.status, data); $done(); });"
        }
      ],
      "resources": {
        "response.js": {
          "data_type": "text",
          "data": "const body=JSON.parse($response.body); body.debug=true; $response.headers.push({field:'X-Script',value:'B-box'}); $done({headers:$response.headers,body:JSON.stringify(body)});"
        }
      }
    }
  }
}
