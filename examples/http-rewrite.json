{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "http-tools",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "experimental": {
    "mitm": {
      "enabled": false,
      "hosts": [
        "api.example.test"
      ],
      "block_quic": true,
      "h2": false,
      "skip_server_cert_verify": false,
      "tcp": false
    },
    "http_rewrite": {
      "enabled": true,
      "ports": [
        80,
        443,
        8080,
        8443
      ],
      "max_body_bytes": 1048576,
      "header_rewrite": [
        {
          "name": "Request header",
          "pattern": "^https?://api\\.example\\.test/",
          "phase": "request",
          "operation": "add",
          "header": "X-Debug",
          "value": "B-box"
        },
        {
          "name": "Response header",
          "pattern": "^https?://api\\.example\\.test/",
          "phase": "response",
          "operation": "add",
          "header": "X-Rewritten",
          "value": "1"
        }
      ],
      "url_rewrite": [
        {
          "name": "Redirect",
          "pattern": "^https?://api\\.example\\.test/old$",
          "action": "307",
          "replacement": "https://api.example.test/new"
        },
        {
          "name": "Reject",
          "pattern": "^https?://api\\.example\\.test/ads/",
          "action": "reject"
        }
      ],
      "map_remote": [
        {
          "name": "Alternate server",
          "pattern": "^https?://api\\.example\\.test/remote/(.*)$",
          "replacement": "https://backend.example.test/$1",
          "preserve_host": false
        }
      ],
      "body_rewrite": [
        {
          "name": "Request text",
          "pattern": "^https?://api\\.example\\.test/echo$",
          "phase": "request",
          "regex": "old-value",
          "replacement": "new-value"
        },
        {
          "name": "Response text",
          "pattern": "^https?://api\\.example\\.test/echo$",
          "phase": "response",
          "regex": "old-result",
          "replacement": "new-result"
        }
      ],
      "map_local": [
        {
          "name": "Static API mock",
          "pattern": "^https?://api\\.example\\.test/mock$",
          "status": 200,
          "resource": "mock.json",
          "headers": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "name": "Empty pixel",
          "pattern": "^https?://api\\.example\\.test/pixel$",
          "data_type": "tiny-gif"
        }
      ],
      "resources": {
        "mock.json": {
          "data_type": "text",
          "data": "{\"ok\":true,\"source\":\"Map Local\"}"
        }
      }
    }
  }
}
